{
  "name": "tutingo-ad",
  "version": "1.0.0",
  "private": true,
  "description": "Publicité vidéo TutinGo (Remotion, 1080x1920, 30 fps)",
  "scripts": {
    "dev": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts TutinGoAd out/tutingo-ad.mp4 --codec=h264 --crf=18 --audio-codec=aac",
    "still": "remotion still src/index.ts TutinGoAd out/preview.png --frame=400",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "4.0.535",
    "@remotion/fonts": "^4.0.535",
    "@remotion/media-utils": "4.0.535",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "remotion": "4.0.535"
  },
  "devDependencies": {
    "@types/react": "19.1.12",
    "typescript": "5.9.2"
  }
}
